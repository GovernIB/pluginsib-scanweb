<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>pluginsib-scanweb-iecisascanweb-plugin</artifactId>
    <name>PluginsIB - Scan Web - IECISA - Plugin</name>
    <parent>
        <groupId>org.fundaciobit.pluginsib.scanweb</groupId>
        <artifactId>pluginsib-scanweb</artifactId>
        <version>5.0.0-SNAPSHOT</version>
    </parent>
    <dependencies>

        <dependency>
            <groupId>org.fundaciobit.pluginsib.scanweb</groupId>
            <artifactId>pluginsib-scanweb-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- iText -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.1.3</version>
            <type>jar</type>
        </dependency>


    </dependencies>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy1</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.fundaciobit.pluginsib.scanweb</groupId>
                                    <artifactId>
                                        pluginsib-scanweb-iecisascanweb-applet-signed</artifactId>
                                    <version>3.0.1</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <destFileName>
                                        plugin-scanweb-iecisascanweb-applet.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>
                                ${project.build.directory}/classes/applet</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
